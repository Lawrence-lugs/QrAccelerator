{
    "name": "QrAccelerator",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "cacheFrom": "ghcr.io/lawrence-lugs/qraccelerator"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/opt/miniforge3/envs/ic_dec/bin/python",
                "python.terminal.activateEnvironment": true
            },
            "extensions": [
                "ms-python.python",
                "chipsalliance.verible",
                "eirikpre.systemverilog",
                "wavetrace.vaporview"
            ] 
        }
    }
}
